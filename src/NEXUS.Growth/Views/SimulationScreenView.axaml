<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:startup1="clr-namespace:NEXUS.Growth.ViewModels"
             xmlns:services="clr-namespace:NEXUS.Growth.Services"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NEXUS.Growth.Views.SimulationScreenView"
             x:DataType="startup1:SimulationScreenViewModel">
    <ItemsControl ItemsSource="{Binding SimulationService.Processes}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:SimulationProcess">
                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource ButtonBackground}"
                        Margin="8"
                        Padding="8">
                    <StackPanel Spacing="8" Width="300" Height="400">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SelectableTextBlock VerticalAlignment="Center" Text="{Binding Id, StringFormat='ID Процесса: {0}'}" />
                            <Button Theme="{StaticResource TransparentButton}" Content="{avalonia:MaterialIconExt Kind=ContentCopy}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ElapsedTime, StringFormat='В работе: {0:dd\\.hh\\:mm\\:ss}'}"/>
                        <ScrollViewer Width="250" Height="300" >
                            <ItemsControl ItemsSource="{Binding Logs}"/>
                        </ScrollViewer>
                        <Button HorizontalAlignment="Stretch" Content="{avalonia:MaterialIconTextExt Kind=Stop, Text='Снять процесс', TextFirst=True}"
                                Command="{Binding KillProcessCommand}"/>
                    </StackPanel>    
                </Border>
                
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
