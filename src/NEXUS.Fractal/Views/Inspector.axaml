<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="clr-namespace:NEXUS.Fractal.ViewModels"
             xmlns:converters="clr-namespace:NEXUS.Converters;assembly=NEXUS"
             xmlns:services="clr-namespace:NEXUS.Fractal.Services"
             xmlns:views="clr-namespace:NEXUS.Fractal.Views"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
             x:Class="NEXUS.Fractal.Views.Inspector"
             x:DataType="viewModels:MainWindowViewModel">
    <Border IsVisible="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened}" Margin="4 2"
            CornerRadius="5" Background="{DynamicResource ButtonBackground}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8">
                <ToggleButton Name="ProjectNameToggle"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Theme="{StaticResource TransparentButton}"
                              IsVisible="{Binding !#ProjectNameToggle.IsChecked}">
                    <avalonia:MaterialIconText Kind="PackageVariant" Text="{Binding #ProjectNameTextBox.Text}" />
                </ToggleButton>
                <Grid IsVisible="{Binding #ProjectNameToggle.IsChecked}"
                      ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                    <avalonia:MaterialIcon Grid.Column="0" Kind="PackageVariant" />
                    <TextBox Name="ProjectNameTextBox" Grid.Column="1"
                             Watermark="Введите имя проекта"
                             Text="{Binding ProjectService.Project.Name}" />
                    <ToggleButton IsChecked="{Binding !#ProjectNameToggle.IsChecked}"
                                  Grid.Column="2"
                                  Content="{avalonia:MaterialIconExt Kind=TextBoxCheck}"
                                  ToolTip.Tip="Закончить редактирование" />
                </Grid>
                <ComboBox HorizontalAlignment="Stretch" Width="NaN"
                          ItemsSource="{Binding  ProjectService.ColorTables}"
                          SelectedItem="{Binding ProjectService.SelectedColorTable, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, 8, Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}" />
                                <Rectangle Grid.Column="2"
                                           Width="100"
                                           Height="20"
                                           Fill="{Binding Colors, Converter={x:Static converters:HorizontalColorsToGradientConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TabControl SelectedIndex="{Binding ProjectService.SelectedTab, Mode=TwoWay}">
                <TabItem TabIndex="{x:Static services:ProjectService.FramesTab}">
                    <TabItem.Header>
                        <StackPanel ToolTip.Tip="Список данных в 2D и 3D представлении"
                                    Background="Transparent" Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIconText Spacing="8" Kind="Frame" Text="Фреймы" />
                            <Border ToolTip.Tip="Количество фреймов"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="5">
                                <TextBlock Margin="4 0" Text="{Binding ProjectService.Project.Frames.Count}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                            <StackPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Width" Value="30"/>
                                    <Setter Property="Height" Value="30"/>
                                    <!-- <Setter Property="Theme" Value="{StaticResource TransparentButton}"/> -->
                                </Style>
                            </StackPanel.Styles>
                            <Button Content="{avalonia:MaterialIconExt Kind=FileTree}"
                                    ToolTip.Tip="Дерево фреймов">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Icon="{avalonia:MaterialIconExt Kind=ExpandAll}" 
                                                  Header="Развернуть все"
                                                  Click="ExpandFrameTree"/>
                                        <MenuItem Icon="{avalonia:MaterialIconExt Kind=CollapseAll}" 
                                                  Header="Свернуть все"
                                                  Click="CollapseFrameTree"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="{avalonia:MaterialIconExt Kind=Image}"
                                    ToolTip.Tip="Действия над фреймами">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Icon="{avalonia:MaterialIconExt Kind=ImageAdd}" 
                                                  Header="Импортировать"
                                                  Command="{Binding ImportToProjectCommand}"/>
                                        <MenuItem Icon="{avalonia:MaterialIconExt Kind=ControlPointDuplicate}" 
                                                  Header="Клонировать"
                                                  Command="{Binding CloneFrameCommand}"/>
                                        <MenuItem Icon="{avalonia:MaterialIconExt Kind=ImageRemove}" 
                                                  Header="Удалить"
                                                  Command="{Binding RemoveFrameCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TreeView Name="FrameTree"
                                  SelectionMode="Multiple"
                                  ItemsSource="{Binding  ProjectService.Project.Frames}"
                                  SelectedItem="{Binding ProjectService.SelectedFrame}"
                                  SelectedItems="{Binding ProjectService.SelectedFrames}">
                            <TreeView.Styles>
                                <Style Selector="TreeView#FrameTree > TreeViewItem" x:DataType="viewModels:FrameViewModel">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                    <Setter Property="ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout>
                                                <MenuItem Icon="{avalonia:MaterialIconExt Kind=ControlPointDuplicate}" 
                                                          Header="Клонировать"
                                                          Command="{ReflectionBinding $parent[views:MainWindow].DataContext.CloneFrameCommand}"/>
                                                <MenuItem Icon="{avalonia:MaterialIconExt Kind=ImageRemove}" 
                                                          Header="Удалить"
                                                          Command="{ReflectionBinding $parent[views:MainWindow].DataContext.RemoveFrameCommand}"/>
                                                <Separator/>
                                                <MenuItem Icon="{avalonia:MaterialIconExt Kind=ExpandVertical}" 
                                                          Header="Развернуть"
                                                          Click="ExpandFrame"/>
                                                <MenuItem Icon="{avalonia:MaterialIconExt Kind=CollapseVertical}" 
                                                          Header="Свернуть"
                                                          Click="CollapseFrame"/>
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="{x:Type viewModels:FrameViewModel}"
                                                  ItemsSource="{Binding Children}">
                                    <avalonia:MaterialIconText Kind="ImageFilterHdrOutline" Text="{Binding Name}" />
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem TabIndex="{x:Static services:ProjectService.ResearchesTab}">
                    <TabItem.Header>
                        <StackPanel ToolTip.Tip="Список графиков данных по выбранному изменению"
                                    Background="Transparent" Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIconText Spacing="8" Kind="ChartBar" Text="Графики" />
                            <Border ToolTip.Tip="Количество графиков"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="5">
                                <TextBlock Margin="4 0"
                                           Text="{Binding ProjectService.Project.Researches.Count}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ListBox ItemsSource="{Binding ProjectService.Project.Researches}"
                             SelectedItem="{Binding ProjectService.SelectedResearch}">
                        <ListBox.DataTemplates>
                            <DataTemplate x:DataType="viewModels:FractalDimensionResearchViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding ParentName}"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>