<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdaSurface="clr-namespace:NEXUS.Fractal.Controls.MdaSurface"
             xmlns:viewCube="clr-namespace:NEXUS.Fractal.Controls.ViewCube"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NEXUS.Fractal.Controls.MdaSurface.MdaSurface"
             x:DataType="mdaSurface:MdaSurface"
             Background="Transparent">
	<Design.PreviewWith>
		<mdaSurface:MdaSurface/>
	</Design.PreviewWith>
	<Panel>
		<mdaSurface:SurfaceOpenGlControl Name="SurfaceOpenGl" Background="{StaticResource ThemeBackgroundBrush}"/>
		<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">
			<viewCube:ViewCubeControl Grid.Row="0" Grid.Column="1"
			                          Margin="-20 -10"
			                          Width="120" Height="120"
			                          ViewSelected="OnViewCubeViewSelected"/>
		</Grid>
	</Panel>
</UserControl>
