<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:converters="clr-namespace:NEXUS.Converters;assembly=NEXUS"
        xmlns:viewModels="clr-namespace:NEXUS.Fractal.ViewModels"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="clr-namespace:NEXUS.Fractal.Views"
        xmlns:behaviors="clr-namespace:NEXUS.Behaviors;assembly=NEXUS"
        xmlns:helpers="clr-namespace:NEXUS.Helpers;assembly=NEXUS"
        xmlns:models="clr-namespace:NEXUS.Fractal.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NEXUS.Fractal.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        MinWidth="600"
        MinHeight="400"
        Icon="/Assets/FractalSurface.ico"
        Title="{Binding Version, StringFormat='NEXUS.Fractal {0}'}">
    <DockPanel>
        <Border DockPanel.Dock="Top" CornerRadius="5" Margin="4 2" Background="{DynamicResource ButtonBackground}">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" ColumnSpacing="8" Margin="4">
                <Button Grid.Column="0"
                        Theme="{DynamicResource TransparentButton}"
                        Content="{avalonia:MaterialIconTextExt Kind=File, Text=Файл}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=Add}"
                                      Header="Создать проект"
                                      Command="{Binding CreateProjectCommand}" />
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=File}"
                                      Header="Открыть проект"
                                      Command="{Binding OpenProjectCommand}" />
                            <MenuItem Classes="SubItems" Icon="{avalonia:MaterialIconExt Kind=Recent}"
                                      IsEnabled="{Binding ProjectService.RecentProjects.Count}"
                                      Header="Недавние проекты" ItemsSource="{Binding ProjectService.RecentProjects}">
                                <MenuItem.Styles>
                                    <Style Selector="MenuItem.SubItems MenuItem" x:DataType="models:RecentProjectModel">
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <Template>
                                                    <avalonia:MaterialIcon Kind="PackageVariant" />
                                                </Template>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Header" Value="{Binding Name}" />
                                        <Setter Property="ToolTip.Tip" Value="{Binding Directory}" />
                                        <Setter Property="Command"
                                                Value="{ReflectionBinding $parent[views:MainWindow].DataContext.OpenRecentProjectCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                    </Style>
                                </MenuItem.Styles>
                            </MenuItem>
                            <MenuItem Header="-" />
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=ContentSave}"
                                      Header="Сохранить"
                                      Command="{Binding SaveProjectCommand}" />
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=ContentSaveAdd}"
                                      Header="Сохранить как"
                                      Command="{Binding SaveAsProjectCommand}" />
                            <MenuItem Header="-" />
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=Import}"
                                      Header="Импорт данных"
                                      Command="{Binding ImportToProjectCommand}" />
                            <MenuItem Icon="{avalonia:MaterialIconExt Kind=Export}"
                                      Header="Экспорт данных"
                                      Command="{Binding ExportFromProjectCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="1"
                        Theme="{DynamicResource TransparentButton}"
                        Content="{avalonia:MaterialIconTextExt Kind=Resume, Text=Результаты}">
                </Button>
                <Button Grid.Column="2"
                        Theme="{DynamicResource TransparentButton}"
                        Content="{avalonia:MaterialIconTextExt Kind=DockWindow, Text=Панели}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem ToggleType="CheckBox" Icon="{avalonia:MaterialIconExt Kind=DockLeft}"
                                      Header="Левая панель"
                                      IsChecked="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened, Mode=TwoWay}" />
                            <MenuItem ToggleType="CheckBox" Icon="{avalonia:MaterialIconExt Kind=DockRight}"
                                      Header="Правая панель"
                                      IsChecked="{Binding SettingsMenuItemScreen.Settings.RightPaneOpened, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="3"
                        Theme="{DynamicResource TransparentButton}"
                        Content="{avalonia:MaterialIconTextExt Kind=Settings, Text=Настройки}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem ToggleType="CheckBox" Icon="{avalonia:MaterialIconExt Kind=MoonAndStars}"
                                      Header="Тёмная тема"
                                      IsChecked="{Binding SettingsMenuItemScreen.CommonSettings.IsDarkThemeToggled, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
        <controls:InfoBar DockPanel.Dock="Top"
                          Padding="0"
                          Margin="0"
                          Title="{Binding UpdateVersion, StringFormat='Обновление {0}: '}"
                          Message="Рекомендуется установить последнюю версию приложения"
                          IsOpen="True"
                          IsClosable="True"
                          IsIconVisible="True"
                          IsVisible="{Binding IsUpdateFound}">
            <controls:InfoBar.ActionButton>
                <Button Command="{Binding UpdateCommand}"
                        ToolTip.Tip="Установить обновление (приложение перезапустится)">
                    <avalonia:MaterialIcon Kind="MonitorArrowDownVariant" />
                </Button>
            </controls:InfoBar.ActionButton>
        </controls:InfoBar>
        <!--  -->

        <Grid Name="RootGrid"
              IsVisible="{Binding ProjectService.HasProject}"
              helpers:GridHelpers.PixelColumnWidths="{Binding  SettingsMenuItemScreen.Settings.ColumnWidths, Mode=TwoWay}">
            <Interaction.Behaviors>
                <behaviors:HideGridColumnBehavior ColumnIndex="0"
                                                  IsVisible="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened}" />
                <behaviors:HideGridColumnBehavior ColumnIndex="1"
                                                  IsVisible="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened}" />
                <behaviors:HideGridColumnBehavior ColumnIndex="3"
                                                  IsVisible="{Binding SettingsMenuItemScreen.Settings.RightPaneOpened}" />
                <behaviors:HideGridColumnBehavior ColumnIndex="4"
                                                  IsVisible="{Binding SettingsMenuItemScreen.Settings.RightPaneOpened}" />
            </Interaction.Behaviors>
            <Border IsVisible="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened}" Grid.Column="0" Margin="4 2"
                    CornerRadius="5" Background="{DynamicResource ButtonBackground}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8">
                        <ToggleButton Name="ProjectNameToggle"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Theme="{StaticResource TransparentButton}"
                                      IsVisible="{Binding !#ProjectNameToggle.IsChecked}">
                            <avalonia:MaterialIconText Kind="PackageVariant" Text="{Binding #ProjectNameTextBox.Text}" />
                        </ToggleButton>
                        <Grid IsVisible="{Binding #ProjectNameToggle.IsChecked}"
                              ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                            <avalonia:MaterialIcon Grid.Column="0" Kind="PackageVariant" />
                            <TextBox Name="ProjectNameTextBox" Grid.Column="1"
                                     Watermark="Введите имя проекта"
                                     Text="{Binding ProjectService.Project.Name}" />
                            <ToggleButton IsChecked="{Binding !#ProjectNameToggle.IsChecked}"
                                          Grid.Column="2"
                                          Content="{avalonia:MaterialIconExt Kind=TextBoxCheck}"
                                          ToolTip.Tip="Закончить редактирование" />
                        </Grid>
                        <ComboBox HorizontalAlignment="Stretch" Width="NaN"
                                  ItemsSource="{Binding  ProjectService.ColorTables}"
                                  SelectedItem="{Binding ProjectService.SelectedColorTable, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 8, Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}" />
                                        <Rectangle Grid.Column="2"
                                                   Width="100"
                                                   Height="20"
                                                   Fill="{Binding Colors, Converter={x:Static converters:HorizontalColorsToGradientConverter.Instance}}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TabControl>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel ToolTip.Tip="Список данных в 2D и 3D представлении"
                                            Background="Transparent" Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIconText Spacing="8" Kind="Frame" Text="Фреймы" />
                                    <Border ToolTip.Tip="Количество фреймов"
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="5">
                                        <TextBlock Margin="4 0" Text="{Binding ProjectService.Project.Frames.Count}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <TreeView ItemsSource="{Binding  ProjectService.Project.Frames}"
                                      SelectedItem="{Binding ProjectService.SelectedItem}">
                                <TreeView.DataTemplates>
                                    <TreeDataTemplate DataType="{x:Type viewModels:FrameViewModel}"
                                                      ItemsSource="{Binding Children}">
                                        <avalonia:MaterialIconText Kind="ImageFilterHdrOutline" Text="{Binding Name}" />
                                    </TreeDataTemplate>
                                </TreeView.DataTemplates>
                            </TreeView>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel ToolTip.Tip="Список графиков данных по выбранному изменению"
                                            Background="Transparent" Orientation="Horizontal" Spacing="8">
                                    <avalonia:MaterialIconText Spacing="8" Kind="ChartBar" Text="Графики" />
                                    <Border ToolTip.Tip="Количество графиков"
                                            Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="5">
                                        <TextBlock Margin="4 0"
                                                   Text="{Binding ProjectService.Project.Researches.Count}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding ProjectService.Project.Researches}"
                                     SelectedItem="{Binding ProjectService.SelectedItem}">

                            </ListBox>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter IsVisible="{Binding SettingsMenuItemScreen.Settings.LeftPaneOpened}" Grid.Column="1"
                          Background="Transparent" />
            <ContentControl Grid.Column="2" Content="{Binding ProjectService.SelectedItem}" />
            <GridSplitter IsVisible="{Binding SettingsMenuItemScreen.Settings.RightPaneOpened}" Grid.Column="3"
                          Background="Transparent" />
            <Border IsVisible="{Binding SettingsMenuItemScreen.Settings.RightPaneOpened}" Grid.Column="4" Margin="4 2"
                    CornerRadius="5" Background="{DynamicResource ButtonBackground}">

                <ContentControl Content="{Binding ProjectService.SelectedItem}">
                    <ContentControl.DataTemplates>
                        <DataTemplate x:DataType="viewModels:FrameViewModel">
                            <DockPanel>
                                <Panel DockPanel.Dock="Top">
                                    <ToggleButton Name="FrameNameToggle"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  Theme="{StaticResource TransparentButton}"
                                                  IsVisible="{Binding !#FrameNameToggle.IsChecked}">
                                        <avalonia:MaterialIconText Kind="PackageVariant"
                                                                   Text="{Binding #FrameNameTextBox.Text}" />
                                    </ToggleButton>
                                    <Grid IsVisible="{Binding #FrameNameToggle.IsChecked}"
                                          ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">
                                        <avalonia:MaterialIcon Grid.Column="0" Kind="PackageVariant" />
                                        <TextBox Name="FrameNameTextBox" Grid.Column="1"
                                                 Watermark="Введите имя проекта"
                                                 Text="{Binding Name}" />
                                        <ToggleButton IsChecked="{Binding !#FrameNameToggle.IsChecked}"
                                                      Grid.Column="2"
                                                      Content="{avalonia:MaterialIconExt Kind=TextBoxCheck}"
                                                      ToolTip.Tip="Закончить редактирование" />
                                    </Grid>
                                </Panel>
                                <ScrollViewer IsVisible="{Binding SelectedViewTabIndex, Converter={x:Static converters:ValueEqualityConverter.Instance}, ConverterParameter={x:Static viewModels:FrameViewModel.Tab2DIndex}}">
                                    <StackPanel Spacing="8" Margin="8">
                                        <StackPanel.Styles>
                                            <Style Selector="controls|NumberBox">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
                                                <Setter Property="LargeChange" Value="1" />
                                                <Setter Property="SmallChange" Value="0.1" />
                                                <Setter Property="SimpleNumberFormat" Value="F4" />
                                            </Style>
                                        </StackPanel.Styles>
                                        <avalonia:MaterialIconText Kind="Palette" Text="Цветовая палетка" Classes="Title"
                                                                   Foreground="{DynamicResource SystemAccentColor}" />
                                        <controls:NumberBox Name="ColorTableMax"
                                            Header="{avalonia:MaterialIconTextExt Kind=FormatVerticalAlignTop, Text=Максимальный предел высоты}"
                                            Value="{Binding ColorTableMaximum}" />
                                        <controls:NumberBox Name="ColorTableMin"
                                            Header="{avalonia:MaterialIconTextExt Kind=FormatVerticalAlignBottom, Text=Минимальный предел высоты}"
                                            Value="{Binding ColorTableMinimum}" />
                                        <controls:NumberBox Name="ColorTableUpper" Minimum="{ReflectionBinding #ColorTableLower.Value}" Maximum="{ReflectionBinding #ColorTableMax.Value}"
                                            Header="{avalonia:MaterialIconTextExt Kind=ArrowUpThin, Text=Верхнее значение высоты}"
                                            Value="{Binding ColorTableUpperSelection}" />
                                        <controls:NumberBox Name="ColorTableLower" Minimum="{ReflectionBinding #ColorTableMin.Value}" Maximum="{ReflectionBinding #ColorTableUpper.Value}"
                                            Header="{avalonia:MaterialIconTextExt Kind=ArrowDownThin, Text=Нижнее значение высоты}"
                                            Value="{Binding ColorTableLowerSelection}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer IsVisible="{Binding SelectedViewTabIndex, Converter={x:Static converters:ValueEqualityConverter.Instance}, ConverterParameter={x:Static viewModels:FrameViewModel.Tab3DIndex}}">
                                    <StackPanel Spacing="8" Margin="8">
                                        <StackPanel.Styles>
                                            <Style Selector="controls|NumberBox">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
                                                <Setter Property="LargeChange" Value="1" />
                                                <Setter Property="SmallChange" Value="0.1" />
                                                <Setter Property="SimpleNumberFormat" Value="F4" />
                                            </Style>
                                        </StackPanel.Styles>
                                        <avalonia:MaterialIconText Kind="Cctv" Text="Камера" Classes="Title"
                                                                   Foreground="{DynamicResource SystemAccentColor}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=Magnify, Text=Текущее приближение}"
                                            Value="{Binding Zoom}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=AxisZRotateClockwise, Text=Поворот камеры}"
                                            Value="{Binding ModelYaw}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=AxisXRotateClockwise, Text=Наклон камеры}"
                                            Value="{Binding ModelPitch}" />
                                        <Rectangle Fill="{DynamicResource SystemAccentColor}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="2" />
                                        <avalonia:MaterialIconText Kind="TextureBox" Text="Поверхность" Classes="Title"
                                                                   Foreground="{DynamicResource SystemAccentColor}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=Mountain, Text=Коэффициент усиления высоты}"
                                            Value="{Binding HeightMultiplier}" Minimum="0" Maximum="5" />
                                        <ToggleSwitch
                                            OnContent="{avalonia:MaterialIconTextExt Kind=CubeOutline, Text=Подложка включена}"
                                            OffContent="{avalonia:MaterialIconTextExt Kind=CubeOffOutline, Text=Подложка выключена}"
                                            IsChecked="{Binding ShowFoundation}" />
                                        <Rectangle Fill="{DynamicResource SystemAccentColor}"
                                                   HorizontalAlignment="Stretch"
                                                   Height="2" />
                                        <avalonia:MaterialIconText Kind="LightbulbOnOutline" Text="Освещение"
                                                                   Classes="Title"
                                                                   Foreground="{DynamicResource SystemAccentColor}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=AxisXArrow, Text=Координата X}"
                                            Value="{Binding LightPositionX}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=AxisYArrow, Text=Координата Y}"
                                            Value="{Binding LightPositionY}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=AxisZArrow, Text=Координата Z}"
                                            Value="{Binding LightPositionZ}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=Brightness6, Text=Яркость}"
                                            Value="{Binding AmbientStrength}" />
                                        <controls:NumberBox
                                            Header="{avalonia:MaterialIconTextExt Kind=Glasses, Text=Зеркальность}"
                                            Value="{Binding SpecularStrength}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

            </Border>
        </Grid>
    </DockPanel>
</Window>