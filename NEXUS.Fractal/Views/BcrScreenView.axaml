<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mda="clr-namespace:NEXUS.Parsers.MDT.Models.Frames.MDA;assembly=NEXUS.Parsers.MDT"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:NEXUS.Converters;assembly=NEXUS"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:NEXUS.Fractal.ViewModels"
             xmlns:views="clr-namespace:NEXUS.Fractal.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NEXUS.Fractal.Views.BcrScreenView"
             x:DataType="viewModels:BcrScreenViewModel">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Stretch">
            <Button ToolTip.Tip="Выбрать папку для работы с изображениями"
                    Command="{Binding OpenCommand}">
                <avalonia:MaterialIcon Kind="Folder" />
            </Button>

            <ComboBox ItemsSource="{Binding BcrService.ColorTables}"
                      SelectedItem="{Binding BcrService.SelectedColorTable}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, 8, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}" />
                            <Rectangle Grid.Column="2"
                                       Width="100"
                                       Height="20"
                                       Fill="{Binding Colors, Converter={x:Static converters:ColorsToGradientConverter.Instance}}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <controls:RangeSlider DockPanel.Dock="Top"
                              Minimum="0"
                              Maximum="100"
                              RangeStart="{Binding BcrService.RangeStart}"
                              RangeEnd="{Binding BcrService.RangeEnd}">
        </controls:RangeSlider>
        
        <views:BcrFrameView DataContext="{Binding BcrService.Frame}" 
                            IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}"/> 
    </DockPanel>
</UserControl>