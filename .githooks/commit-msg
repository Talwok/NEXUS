#!/bin/bash
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Регулярное выражение для Conventional Commits
regex='^(feat|fix|docs|style|refactor|test|chore|perf|build|ci|revert)(\([a-z-]+\))?: .{1,50}'

if ! echo "$commit_msg" | grep -qE "$regex"; then
    echo "❌ Неправильный формат сообщения коммита!"
    echo "💡 Используйте: <type>(<scope>): <description>"
    echo "💡 Типы: feat, fix, docs, style, refactor, test, chore, perf, build, ci, revert"
    echo "💡 Пример: feat(ui): добавить темную тему"
    exit 1
fi

echo "✅ Сообщение коммита валидно"