#!/bin/bash
echo "🚀 Running pre-commit checks..."

cd src

# Проверка форматирования кода
echo "📝 Checking code formatting..."
dotnet format --verify-no-changes --verbosity diagnostic
if [ $? -ne 0 ]; then
    echo "❌ Code formatting issues found. Run 'dotnet format' to fix."
    exit 1
fi

# Проверка на наличие отладочного кода
echo "🐛 Checking for debug code..."
if git diff --cached --name-only | xargs grep -l "TODO\|FIXME\|DEBUG" 2>/dev/null; then
    echo "⚠️  Found TODO/FIXME in committed files. Continue? [y/N]"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo "✅ Pre-commit checks passed!"
exit 0